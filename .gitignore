.DS_Store
.idea/
.vscode/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environment and secrets
.env
.env.*
!.env.example

# Competition data and generated artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/
output/
artifacts/
models/
mlruns/

# Each member owns generated artifacts inside their workspace.
# Exception: the hand-labelling journal. It is 35 KB of human judgement — the
# one thing in data/ that cannot be regenerated by rerunning anything — so it is
# tracked while the rest of data/ (prediction dumps, in-sample caches) is not.
# The rule matches contents rather than the directory, otherwise git never
# descends into it and the negation below can never fire.
members/*/data/*
!members/*/data/label_audit.jsonl
members/*/output/
members/*/submissions/
members/*/subs/
members/*/artifacts/
members/*/models/
members/*/mlruns/

# Organizer baseline unpacked for code inspection (contains model weights)
members/*/baselines_ref/

# Container build output. The source is tracked (run.py, metadata.json,
# build_artifact.py, artifact.json); everything the build steps generate is not:
# trained weights, vendored wheels, and the copies of shared modules that
# build_zip.py drops into src/.
# Двойная звёздочка обязательна: у контейнеров-блендов компоненты вложены на
# уровень глубже (container/blend4/joint/model.pt), и правило с одной звёздочкой
# их не ловило — в коммит уходило 2.6 ГБ весов.
members/*/container/**/model.*
members/*/container/**/vendor/
members/*/container/**/src/
# отображение «сырой токен -> индекс» на 18 МБ; пересобирается
# скриптом members/darksteeld/src/build_stem_map.py
members/*/container/**/stem_map.npz

# Shared validation: labels and raw predictions stay local; only the builder,
# pinned SHA256 hashes, result JSONs, and leaderboards are committed
validation/targets/
validation/predictions/
# same rule for every later fold specification (targets_v2, predictions_v2, ...)
validation/targets_*/
validation/predictions_*/
__MACOSX/
